{
  "manifest_version": 3,
  "name": "eloter tunnel",
  "version": "0.4.0",
  "description": "Connect Chrome web traffic to your local eloter Node companion. Respects managed proxy policies.",
  "permissions": ["proxy"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "eloter tunnel"},
  "icons": {"16":"icons/16.png","32":"icons/32.png","48":"icons/48.png","128":"icons/128.png"}
}
